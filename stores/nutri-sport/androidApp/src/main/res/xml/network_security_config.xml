<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Dev only: the Ktor server runs over plain HTTP on the LAN.
         192.168.0.120 - dev machine on Wi-Fi (keep in sync with ServerUrl.android.kt)
         10.0.2.2      - host loopback as seen from the Android emulator -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">192.168.0.120</domain>
        <domain includeSubdomains="true">10.0.2.2</domain>
        <domain includeSubdomains="true">localhost</domain>
    </domain-config>
</network-security-config>
